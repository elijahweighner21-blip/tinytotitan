--!strict
--[[
	QuestConfig
	All quests. Objectives are matched by QuestService against gameplay events
	(see QuestService.ObjectiveTypes for the full list):

	  Collect(Target = collectible type | "Any")   Discover(Target = id | "Any")
	  ReachTier(Count = tier)                      ReachLevel(Count = level)
	  EarnMass(Count)                              DefeatEnemy(Target | "Any")
	  DefeatBoss(Target)                           CompleteChallenge(Target | "Any")
	  TalkTo(Target = npc id)                      BuyUpgrade(Target | "Any")
	  UnlockSkill(Target | "Any")                  UseAbility(Target)
	  BreakObject(Target | "Any")                  MoveObject(Target = verb Push/Carry/Throw)
	  EnterZone(Target = zone id)                  GatherResource(Target = resource id)
	  JoinEvent(Target | "Any")                    FastTravel()   Ascend()

	Rewards use RewardConfig.zone so balancing a zone rebalances all its quests.
	`Marker` names a world target (discovery / npc / challenge / boss id) for the
	quest arrow and map.
]]

local Types = require(script.Parent.Parent.Types)
local RewardConfig = require(script.Parent.RewardConfig)

type Quest = Types.Quest
type Reward = Types.Reward

local R = RewardConfig.zone

local function with(base: Reward, extra: Reward): Reward
	for k, v in extra :: any do
		(base :: any)[k] = v
	end
	return base
end

