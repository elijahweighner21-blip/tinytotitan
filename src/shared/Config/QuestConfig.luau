local byId: { [string]: Quest } = {}
for _, q in List do
	assert(byId[q.Id] == nil, "duplicate quest " .. q.Id)
	byId[q.Id] = q
end

local QuestConfig = {
	List = List,
	MaxActive = 8,
	-- Story quests cannot be abandoned.
	NonAbandonable = { Story = true } :: { [string]: boolean },
}

function QuestConfig.get(id: string): Quest?
	return byId[id]
end

return QuestConfig
