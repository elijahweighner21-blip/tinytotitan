local byId: { [string]: Enemy } = {}
for _, def in List do
	assert(byId[def.Id] == nil, "duplicate enemy " .. def.Id)
	byId[def.Id] = def
end

local EnemyConfig = {
	List = List,
	-- AI activation: spawners only populate when a player is within this many
	-- spawner radii, and despawn after nobody has been near for SleepAfter.
	ActivationRadiusMultiplier = 3,
	SleepAfter = 25,
	AITickRate = 0.2, -- seconds between AI decisions (movement is physics-smoothed)
	-- Safe zones: enemies never target players within this many zone-player
	-- heights of a zone spawn or fast-travel pad (no spawn camping).
	SafeZoneHeights = 12,
	MaxEnemiesPerServer = 120,
	StaggerTime = 0.6,
	RespawnDelay = 18,
	LeashRadiusMultiplier = 2.5, -- enemies return home beyond this
	-- Enemies ignore players more than this many times their own size.
	IgnoreSizeRatio = 8,
	CritChance = 0.08,
}

function EnemyConfig.get(id: string): Enemy?
	return byId[id]
end

return EnemyConfig
