local byId: { [string]: Upgrade } = {}
for _, def in List do
	assert(byId[def.Id] == nil, "duplicate upgrade id " .. def.Id)
	byId[def.Id] = def
end

local UpgradeConfig = {
	Categories = Categories,
	List = List,
}

function UpgradeConfig.get(id: string): Upgrade?
	return byId[id]
end

return UpgradeConfig
