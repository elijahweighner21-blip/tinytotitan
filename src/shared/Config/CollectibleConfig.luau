--!strict
--[[
	CollectibleConfig
	Collectible TYPES. Placements are generated by the world builder (each
	placed instance gets a stable Id like "Bedroom_TitanShard_3"). Unique
	collectibles count toward zone collections; respawning ones (orbs, resource
	nodes) are per-player and come back after `Respawn` seconds.
]]

local Types = require(script.Parent.Parent.Types)

export type CollectibleType = {
	Id: string,
	Name: string,
	Unique: boolean,
	Respawn: number?,
	Reward: Types.Reward,
	ZoneScaled: boolean,
	Color: Color3,
	Shape: "Orb" | "Coin" | "Shard" | "Relic" | "Toy" | "Fragment" | "Crystal" | "Star",
	Size: number, -- multiple of the zone's intended player height
	Rarity: string,
	Hidden: boolean?,
}

local Types_: { CollectibleType } = {
	{ Id = "GrowthOrb", Name = "Growth Orb", Unique = false, Respawn = 75, Reward = { Mass = 6, GrowthEnergy = 3, XP = 2 }, ZoneScaled = true, Color = Color3.fromRGB(120, 255, 140), Shape = "Orb", Size = 0.35, Rarity = "Common" },
	{ Id = "GoldenOrb", Name = "Golden Growth Orb", Unique = false, Respawn = 240, Reward = { Mass = 40, GrowthEnergy = 20, XP = 10 }, ZoneScaled = true, Color = Color3.fromRGB(255, 210, 60), Shape = "Orb", Size = 0.45, Rarity = "Rare" },
	{ Id = "ResourceNode", Name = "Resource Cluster", Unique = false, Respawn = 120, Reward = { Mass = 4, XP = 2 }, ZoneScaled = true, Color = Color3.fromRGB(200, 160, 255), Shape = "Crystal", Size = 0.5, Rarity = "Common" },
	{ Id = "LostCoin", Name = "Lost Coin", Unique = true, Reward = { Mass = 60, GrowthEnergy = 40, XP = 20 }, ZoneScaled = true, Color = Color3.fromRGB(230, 190, 90), Shape = "Coin", Size = 0.5, Rarity = "Uncommon" },
	{ Id = "TitanShard", Name = "Titan Shard", Unique = true, Reward = { TitanShards = 3, XP = 30 }, ZoneScaled = false, Color = Color3.fromRGB(90, 200, 255), Shape = "Shard", Size = 0.5, Rarity = "Rare" },
	{ Id = "Relic", Name = "Ancient Relic", Unique = true, Reward = { Mass = 200, TitanShards = 2, XP = 60 }, ZoneScaled = true, Color = Color3.fromRGB(255, 140, 60), Shape = "Relic", Size = 0.6, Rarity = "Epic" },
	{ Id = "HiddenToy", Name = "Hidden Toy", Unique = true, Reward = { Mass = 120, GrowthEnergy = 80, XP = 40 }, ZoneScaled = true, Color = Color3.fromRGB(255, 100, 180), Shape = "Toy", Size = 0.6, Rarity = "Uncommon" },
	{ Id = "MemoryFragment", Name = "Memory Fragment", Unique = true, Reward = { Mass = 150, XP = 80, TitanShards = 1 }, ZoneScaled = true, Color = Color3.fromRGB(200, 170, 255), Shape = "Fragment", Size = 0.5, Rarity = "Epic" },
	{ Id = "SecretStar", Name = "Secret Star", Unique = true, Reward = { Mass = 300, GrowthEnergy = 150, XP = 100, TitanShards = 2 }, ZoneScaled = true, Color = Color3.fromRGB(255, 255, 160), Shape = "Star", Size = 0.5, Rarity = "Legendary", Hidden = true },
}

local byId: { [string]: CollectibleType } = {}
for _, t in Types_ do
	byId[t.Id] = t
end

local CollectibleConfig = {
	Types = Types_,
	-- Base chance a Growth Orb spawns as golden (plus Luck stats).
	GoldenOrbBaseChance = 0.04,
	-- Collection completion rewards (fractions of unique collectibles in a zone).
	CollectionMilestones = {
		{ Fraction = 0.5, Reward = { TitanShards = 5, XP = 150 } },
		{ Fraction = 1.0, Reward = { TitanShards = 20, XP = 600 } },
	} :: { { Fraction: number, Reward: Types.Reward } },
	-- Hidden collectibles are invisible until within this many player heights
	-- (multiplied by SecretFinder stat).
	SecretRevealHeights = 6,
	-- Server tolerance added to pickup range to absorb latency.
	PickupLatencyGrace = 0.35,
}

function CollectibleConfig.get(id: string): CollectibleType?
	return byId[id]
end

return CollectibleConfig
