local Format = require(Shared.Util.Format)
local RateLimiter = require(Shared.Util.RateLimiter)
local Guard = require(Shared.Util.Guard)
local TableUtil = require(Shared.Util.TableUtil)
local MathUtil = require(Shared.Util.MathUtil)

describe("Format", function()
	it("abbreviates", function()
		expect(Format.abbreviate(950)).toBe("950")
		expect(Format.abbreviate(1234)).toBe("1.2K")
		expect(Format.abbreviate(15800)).toBe("15.8K")
		expect(Format.abbreviate(2400000)).toBe("2.4M")
		expect(Format.abbreviate(1.1e9)).toBe("1.1B")
		expect(Format.abbreviate(999999)).toBe("999K")
		expect(Format.abbreviate(0 / 0)).toBe("0")
		expect(Format.abbreviate(-1500)).toBe("-1.5K")
		expect(Format.abbreviate(123456789012)).toBe("123B")
	end)
	it("formats clocks and race times", function()
		expect(Format.clock(75)).toBe("1:15")
		expect(Format.clock(3725)).toBe("1:02:05")
		expect(Format.raceTime(63.456)).toBe("1:03.46")
		expect(Format.commas(1234567)).toBe("1,234,567")
		expect(Format.commas(123)).toBe("123")
	end)
end)

describe("RateLimiter", function()
	it("allows bursts then refills over time", function()
		local t = 0
		local rl = RateLimiter.new(2, 3, function()
			return t
		end)
		expect(rl:Check("p")).toBeTruthy()
		expect(rl:Check("p")).toBeTruthy()
		expect(rl:Check("p")).toBeTruthy()
		expect(rl:Check("p")).toBeFalsy()
		t = 0.5
		expect(rl:Check("p")).toBeTruthy()
		expect(rl:Check("p")).toBeFalsy()
		expect(rl:Check("other")).toBeTruthy()
	end)
end)

describe("Guard", function()
	it("validates shapes strictly", function()
		local g = Guard.shape({ id = Guard.id(), n = Guard.integer(1, 5) })
		expect((g({ id = "Walk", n = 3 }))).toBeTruthy()
		expect((g({ id = "Walk", n = 3, extra = 1 }))).toBeFalsy()
		expect((g({ id = "bad id!", n = 3 }))).toBeFalsy()
		expect((g({ id = "Walk", n = 0 / 0 }))).toBeFalsy()
		expect((g({ id = "Walk", n = 2.5 }))).toBeFalsy()
		expect((g("nope"))).toBeFalsy()
	end)
	it("rejects sparse arrays", function()
		local g = Guard.array(Guard.integer(0, 10), 4)
		expect((g({ 1, 2, 3 }))).toBeTruthy()
		expect((g({ 1, nil, 3 }))).toBeFalsy()
		expect((g({ 1, 2, 3, 4, 5 }))).toBeFalsy()
	end)
end)

describe("TableUtil/MathUtil", function()
	it("reconcile fixes wrong types", function()
		local t = TableUtil.reconcile({ a = "x", b = { c = 1 } }, { a = 0, b = { c = 0, d = 2 } })
		expect(t.a).toBe(0)
		expect(t.b.c).toBe(1)
		expect(t.b.d).toBe(2)
	end)
	it("sanitize handles junk", function()
		expect(MathUtil.sanitize(0 / 0, 0, 10, 5)).toBe(5)
		expect(MathUtil.sanitize("1", 0, 10, 5)).toBe(5)
		expect(MathUtil.sanitize(50, 0, 10, 5)).toBe(10)
	end)
	it("hashString is deterministic", function()
		expect(MathUtil.hashString("abc")).toBe(MathUtil.hashString("abc"))
	end)
end)
